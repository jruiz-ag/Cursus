NAME	= rush-02
CC	= cc
CFLAGS	= -Wall -Wextra -Werror
SRC	= todos_los.c 
OBJ_DIR = obj
OBJECTS	= $(SRC:%.c=$(OBJ_DIR)/%.o)

# La regla all siempre debe ser la primera
all: $(OBJ_DIR) | $(NAME)

# Compilación del ejecutable
$(NAME): $(OBJECTS)
	$(CC) $(CFLAGS) $(OBJECTS) -o $(NAME)

# Creamos un repositorio para esconder los objetos
$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

# Regla implícita para objetos
$(OBJ_DIR)/%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Limpieza de objetos
clean:
	rm -rf $(OBJ_DIR)

# Limpieza completa
fclean: clean
	rm -f $(NAME)

# Recompila todo desde cero
re: fclean all

.PHONY: all clean fclean re
