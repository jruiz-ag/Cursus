NAME	= rush-02
CC	= cc
CFLAGS	= -Wall -Wextra -Werror
SRC	= todos_los.c 
OBJ	= $(SRC:.c=.o)

# La regla all siempre debe ser la primera
all: $(NAME)

# Compilación del ejecutable
$(NAME): $(OBJ)
	$(CC) $(CFLAGS) $(OBJ) -o $(NAME)

# Regla implícita para objetos
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Limpieza de objetos
clean:
	rm -f $(OBJ)

# Limpieza completa
fclean: clean
	rm -f $(NAME)

# Recompila todo desde cero
re: fclean all

.PHONY: clean fclean re
