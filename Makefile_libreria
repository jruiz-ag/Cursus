NAME	= libft.a
CC = CC
LIBC = ar rcs
CFLAGS	= -Wall -Wextra -Werror
SRC	= todos_los.c
OBJECTS	= $(SRC:.c=.o)

# La regla all siempre debe ser la primera
all: $(NAME)

# Creación de la librería estática
$(NAME): $(OBJECTS)
	$(LIBC) $(OBJ) -o $(NAME)

# Compilación de objetos
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Limpieza de objetos
clean:
	rm -f $(OBJECTS)

# Limpieza completa
fclean: clean
	rm -f $(NAME)

# Recompila todo desde cero
re: fclean $(NAME)

.PHONY: clean fclean re
