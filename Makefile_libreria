NAME	= libft.a
CC = cc
LIBC = ar rcs
CFLAGS	= -Wall -Wextra -Werror
SRC	= todos_los.c
OBJ_DIR = obj
OBJECTS	= $(SRC:%.c=$(OBJ_DIR)/%.o)

# La regla all siempre debe ser la primera
all: $(NAME)

# Creación de la librería estática
$(NAME): $(OBJECTS)
	$(LIBC) $(NAME) $(OBJECTS)

# Compilación de objetos en carpeta oculta
$(OBJ_DIR)/%.o: %.c
	@mkdir -p $(OBJ_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

# Limpieza de objetos
clean:
	rm -rf $(OBJ_DIR)

# Limpieza completa
fclean: clean
	rm -f $(NAME)

# Recompila todo desde cero
re: fclean all

.PHONY: all clean fclean re
